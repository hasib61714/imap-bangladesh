# Copy to scripts/dev.secrets.env and fill in. That file is gitignored.
#
# scripts/dev.sh sources this AFTER dev.env, so anything here overrides it.
# Credentials live here rather than in dev.env because dev.env is tracked,
# and a secret in a tracked file is a secret in the repository history from
# the moment it is written.

# ── SSLCommerz ────────────────────────────────────────────────
#
# Get a sandbox store at https://developer.sslcommerz.com/registration/
# The panel is https://sandbox.sslcommerz.com/manage/
#
# SSL_IS_SANDBOX is set EXPLICITLY. utils/payment.js falls back to deriving
# it from the declared environment, and the explicit flag is the difference
# between "sandbox because we said so" and "sandbox because nobody has
# changed NODE_ENV yet". Getting this wrong on a live store moves real money.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSL_IS_SANDBOX=true

# ── Object storage for identity documents (optional locally) ──
#
# Leave unset and the sealed document store falls back to its local driver
# (backend/.private/sealed). Set these to exercise the S3 path.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_SEALED_BUCKET=
