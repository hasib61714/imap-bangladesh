# Local development environment for IMAP.
#
# Sourced by scripts/dev.sh, which EXPORTS these before node starts —
# dotenv does not override an already-set process.env value, so these win
# over backend/.env without that file being touched.
#
# Nothing here can reach production: DB_HOST is loopback, and
# config/environment.js refuses a development process against a
# production database host.
APP_ENV=development
NODE_ENV=development
DATABASE_ENV=development

PORT=5001
DB_HOST=127.0.0.1
DB_PORT=3399
DB_USER=root
DB_PASSWORD=imap-dev-only
DB_NAME=imap_dev
DB_SSL=false

# Dev-only secret. Never reused anywhere else; rotating it just logs
# local sessions out.
JWT_SECRET=dev-only-secret-2f8a4c1e9b7d3a5f6c0e8b2d4a7f1c9e3b6d8a0f2c4e7b9d1a3f5c8e0b2d4a6f
JWT_EXPIRES_IN=15m

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# Object storage is deliberately unconfigured locally. The sealed
# document store then reports capability "no_credentials" and identity
# submission fails closed with 503 — which is the behaviour to see in
# development, not a silent fallback that hides a production
# misconfiguration.
