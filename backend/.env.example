# ─────────────────────────────────────────
#  IMAP Bangladesh – Backend Environment
#  Copy this file to .env and fill values
# ─────────────────────────────────────────

# Server
PORT=5000

# ── Environment identity (Phase 2.75, finding V-01) ──────────────
# APP_ENV is the authoritative statement of what this process is.
# NODE_ENV is honoured as a fallback but is overloaded — build tools and
# hosting platforms write to it for their own reasons.
#
#   development | test | staging | production
#
# UNSET MEANS PRODUCTION. Every guard fails closed: leaving this blank
# gets you strict behaviour, never permissive behaviour.
APP_ENV=development

# What class of data the configured database holds. Set this whenever the
# hostname does not make it obvious. An unrecognised REMOTE host is
# treated as production; only loopback is assumed development.
DATABASE_ENV=development

# The production database host, so a non-production process can recognise
# it even if the hostname is renamed. Optional but recommended.
PRODUCTION_DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com

# ── MySQL / TiDB Cloud ───────────────────────────────────────────
# DO NOT point a development environment at the production cluster.
# Phase 2.5 found exactly that: NODE_ENV said development while DB_HOST
# addressed production, which disabled the demo-seed, mock-settlement,
# wallet-top-up and OTP-exposure protections against real user data.
# backend/db.js now refuses to start in that configuration.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=imap_dev
DB_SSL=false

# ── Break-glass override (leave unset) ───────────────────────────
# Permits a non-production process to address the production database for
# one invocation. The value must be the exact DB_NAME — "true" will not
# work. Migration, seeding, admin-bootstrap and user-dump scripts all
# require it. Demo seeding can never be unlocked by it.
#   IMAP_I_UNDERSTAND_THIS_IS_PRODUCTION=imap_db

# ── Isolated database for integration tests (optional) ───────────
# Must be a loopback address; the suite refuses anything else and skips
# entirely when unset. See docs/engineering/TESTING-STRATEGY.md.
#   IMAP_TEST_DB_HOST=127.0.0.1
#   IMAP_TEST_DB_PORT=3399
#   IMAP_TEST_DB_USER=root
#   IMAP_TEST_DB_PASSWORD=

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS) — no trailing slash
FRONTEND_URL=https://yourdomain.com

# AI Keys (optional — leave blank to use keyword fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google OAuth — get from https://console.cloud.google.com → APIs & Services → Credentials
# Required for real Google login (leave blank to use dev-mode mock)
GOOGLE_CLIENT_ID=

# SSLCommerz Payment Gateway — https://developer.sslcommerz.com
# NAMES CORRECTED in Phase 0.5 (P1-17): this file previously documented
# SSL_STORE_ID / SSL_STORE_PASSWORD, which the code never read. Anyone
# following it ran with no gateway — and an unconfigured gateway used to
# credit wallets for free (P0-12). Both spellings are accepted now, but
# these are the canonical names and they match render.yaml.
#
# In production an unconfigured gateway makes payments return 503.
# It no longer settles anything.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "true" = sandbox. When unset, sandbox is inferred from NODE_ENV.
SSL_IS_SANDBOX=true

# SMS (Twilio / BD SMS gateway)
# SMS_PROVIDER=mock   ← uses mock by default, change to 'twilio' or 'bulksmsbd'
SMS_PROVIDER=mock
# Twilio "From" number. Read as SMS_FROM or TWILIO_PHONE (P1-17).
SMS_FROM=+880XXXXXXXXXX
# Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# BD SMS Gateway (e.g. Shajogoj / BulkSMS):
BD_SMS_API_KEY=
BD_SMS_SENDER_ID=

# Web Push Notifications (VAPID keys)
# Generate: node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(k);"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@imap.bd

# Cloud Storage — Cloudflare R2 (recommended, S3-compatible)
# Leave all blank to use base64 dev fallback
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=imap-uploads
R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# AWS S3 (alternative to R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=

# ── Platform economics ───────────────────────────────────
# Commission taken on each booking, as a percent of the service amount.
# The server computes every money value; the client can no longer send a
# price or a fee (P0-3, P0-4). Leave blank or 0 to keep the current
# behaviour of charging no commission.
PLATFORM_FEE_PCT=0

# ── Administrator bootstrap ──────────────────────────────
# REPLACES the removed `admin123` seed (P0-9). Run: npm run admin:reset
# Provide an identity; the password is either taken from
# ADMIN_BOOTSTRAP_PASSWORD (min 12 chars) or generated and printed once.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ── Demo data (development only) ─────────────────────────
# scripts/seedDemo.js refuses to run when NODE_ENV=production.
# The public GET /api/admin/seed-demo endpoint has been removed (P0-9).
DEMO_SEED_PASSWORD=

# ─────────────────────────────────────────────────────────
#  Carried over from main during the branch integration.
#  These are read by code main contributed; the block above
#  is the contract for everything else.
# ─────────────────────────────────────────────────────────

# Redis. The socket.io Redis adapter uses this to share rooms across
# instances. Unset, the app falls back to a single-process memory adapter,
# which is correct for one instance and wrong for two.
REDIS_URL=
# Set true to refuse to start without Redis, rather than falling back.
REQUIRE_REDIS=false

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# SMS providers (SMS_PROVIDER selects one)
SSLWIRELESS_SID=
SSLWIRELESS_TOKEN=
TWILIO_PHONE=
