{
  "name": "imap-backend",
  "version": "1.0.0",
  "description": "IMAP Bangladesh REST API - Node.js + Express + MySQL",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "admin:reset": "node scripts/resetAdmin.js",
    "test": "node --test \"test/**/*.test.js\" \"tests/**/*.test.js\"",
    "test:unit": "node --test \"test/*.test.js\"",
    "test:integration": "node --test \"test/integration/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\" \"tests/**/*.test.js\"",
    "lint:boundaries": "node scripts/check-boundaries.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:status": "node scripts/migrate.js --status",
    "migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/lib-storage": "^3.995.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.11.3",
    "rate-limit-redis": "^4.3.1",
    "socket.io": "^4.8.3",
    "uuid": "^10.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "js-yaml": "^5.2.3",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
